# Ambiente dos testes de integração. Aponta para uma base de dados PRÓPRIA,
# separada da de desenvolvimento — os testes apagam dados entre casos.
#
# Criar com: npm run test:integration:setup
#
# No CI estas variáveis vêm do workflow, que levanta um Postgres em contentor.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memovoy_test
JWT_SECRET=segredo-de-teste-com-mais-de-32-caracteres-aqui
JWT_REFRESH_SECRET=segredo-refresh-de-teste-com-mais-de-32-caracteres
GROQ_API_KEY=chave-falsa-para-testes
NODE_ENV=test
FRONTEND_URL=http://localhost:3000

# MinIO local (docker compose up -d). Mesmas credenciais do docker-compose.yml,
# que é o contentor de desenvolvimento — não são segredos.
# Sem isto os testes de upload encontram o MinIO de pé, tentam assinar o pedido
# sem chave e apanham um 500 em vez de saltarem.
S3_ENDPOINT=http://localhost:9000
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=memovoy
