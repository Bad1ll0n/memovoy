{
  "name": "memovoy-api",
  "version": "1.0.0",
  "description": "MemoVoy API — Travel social network backend",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "NODE_ENV=production node --env-file=.env src/server.js",
    "test": "node --test \"src/**/*.test.js\" \"src/tests/*.test.js\"",
    "test:integration": "node --test src/tests/integration/*.test.js",
    "test:all": "node --test 'src/**/*.test.js' 'src/tests/integration/*.test.js'",
    "db:migrate": "./setup_db.sh migrate",
    "db:validate": "./setup_db.sh validate",
    "db:info": "./setup_db.sh info",
    "db:clean": "./setup_db.sh clean",
    "worker:push": "node src/workers/push-notifications.js",
    "worker:aggregator": "node src/workers/feed-aggregator.js",
    "workers": "concurrently \"npm run worker:push\" \"npm run worker:aggregator\" \"npm run worker:moderation\" \"npm run worker:fanout\"",
    "worker:moderation": "node src/workers/content-moderation.js",
    "worker:fanout": "node src/workers/kafka-feed-fanout.js"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^4.0.1",
    "argon2": "^0.31.2",
    "dotenv": "^17.4.2",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "pg": "^8.11.5",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.4",
    "redis": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
