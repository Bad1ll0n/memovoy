{
  "name": "memovoy-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env --import ./src/instrumentation.js src/server.js",
    "start": "node --env-file=.env --import ./src/instrumentation.js src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "test": "node --env-file=test/test.env --test \"test/unit/*.test.js\"",
    "test:watch": "node --env-file=test/test.env --test --watch \"test/unit/*.test.js\"",
    "test:integration": "node --env-file=test/integration.env --test --test-concurrency=1 \"test/integration/*.test.js\"",
    "test:integration:setup": "node --env-file=test/integration.env src/db/migrate.js",
    "carga": "node --env-file=test/integration.env test/carga/carga.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.726.1",
    "@aws-sdk/s3-request-presigner": "^3.726.1",
    "@fastify/compress": "^9.0.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/under-pressure": "^9.1.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.12.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "openai": "^4.77.0",
    "pg": "^8.14.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.11",
    "socket.io-client": "^4.8.3"
  }
}
