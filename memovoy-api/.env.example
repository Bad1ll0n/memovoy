# ============================================================
# MemoVoy API — Variáveis de ambiente
# Copiar para .env e preencher os valores
# NUNCA commitar o .env com valores reais
# ============================================================

# Servidor
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Base de dados
# Formato: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://memovoy:memovoy_dev_password@localhost:5433/memovoy_dev
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT — gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=GERAR_COM_COMANDO_ACIMA
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=GERAR_COM_OUTRO_VALOR_DIFERENTE
JWT_REFRESH_TTL=30d

# Encriptação de email — chave AES-256 em base64 (32 bytes)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=GERAR_COM_COMANDO_ACIMA

# Rate limiting
RATE_LIMIT_GLOBAL=200
RATE_LIMIT_AUTH=10

# CORS — origins separadas por vírgula
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Redis
REDIS_URL=redis://localhost:6379

# Push Notifications (opcional — workers correm em dry-run sem estas variáveis)
# FCM (Android)
FCM_SERVER_KEY=
FCM_PROJECT_ID=
# APNs (iOS)
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.memovoy

# Moderação de conteúdo
MODERATION_VISION_ENABLED=false
MODERATION_AUTO_APPROVE=true

# Kafka (fan-out do feed)
# KAFKA_BROKERS=localhost:9092
