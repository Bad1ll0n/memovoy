NODE_ENV=development
PORT=4000

# PostgreSQL — obrigatório, a API não arranca sem isto
DATABASE_URL=postgresql://postgres:password@localhost:5432/memovoy

# JWT — ambos obrigatórios, a API recusa arrancar se faltar algum
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=another-secret-min-32-chars

# Redis — opcional. Sem isto o Socket.IO corre em modo single-node,
# suficiente para desenvolvimento local.
# REDIS_URL=redis://localhost:6379

# AWS S3
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=memovoy

# Endpoint S3 alternativo — usar com o MinIO do docker-compose.yml.
# Deixar vazio para usar a AWS real.
# S3_ENDPOINT=http://localhost:9000

# Frontend URL (para CORS + links de email). Aceita lista separada por vírgulas.
FRONTEND_URL=http://localhost:3000

# IP do proxy de confiança para X-Forwarded-For (o do load balancer, em produção).
# Sem isto o cabeçalho é ignorado, o que evita spoofing de IP.
# TRUSTED_PROXY=10.0.0.1

# OpenTelemetry — desligado por omissão para não poluir o dev local.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=memovoy-api

# VAPID (Web Push — gerar com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@memovoy.com

# SMTP (opcional — sem isto os links de verificação vão para a consola)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM=Memovoy <noreply@memovoy.app>

# ── Fornecedor de IA ─────────────────────────────────────────────────────────
#
# O fornecedor e os modelos deixaram de estar escritos no código. A 2026-08-16 a
# Groq desligou os dois modelos que a app usava — o principal e o de recurso, no
# mesmo dia — e sem isto seria preciso um commit para voltar a ter IA.
#
# Sem configurar nada, usa a Groq com o gpt-oss-120b. Para trocar, basta
# LLM_PROVIDER e a chave; o resto vem do perfil.
#
# Todos os números de velocidade são MEDIDOS por terceiros (Artificial
# Analysis), não anunciados pelos fornecedores. A Cerebras anuncia 3000 t/s e
# mede 1641; para velocidade, o número do fornecedor é um tecto.
#
#   groq       gpt-oss-120b    474 t/s   ~15s   $0.15 / $0.60  <- omissão
#   cerebras   gpt-oss-120b   1641 t/s   ~4s    mais caro (ver nota)
#   deepseek   v4-flash         83 t/s   ~84s   $0.22 / $0.66, o dobro em pico
#
# O mesmo modelo corre em 18 sítios, com um spread de 12x no preço. Os mais
# baratos são baratos por serem lentos: a CoreWeave e a DeepInfra ficam nos
# $0.04-0.05 e fazem ~48 t/s, o que dá 145 segundos para um roteiro. Não vale
# a pena — é a mesma armadilha da DeepSeek.
#
# NOTA sobre o preço da Cerebras: não consegui confirmá-lo na fonte oficial e as
# fontes terceiras discordam entre si ($0.35/$0.75 numas, $0.15 blended noutras).
# Confirmar em cloud.cerebras.ai antes de contar com um número.
#
# A Cerebras corre O MESMO modelo da Groq: mesma qualidade, três vezes mais
# rápida, mais cara. O plano gratuito dela limita o contexto a 8192 tokens, o
# que deixa 192 de folga no agente pesado — curto de mais para uso a sério.
#
# A velocidade não é detalhe: o agente que gera os dias pede 7000 tokens de
# saída. A 500 t/s são ~14 segundos; a 83 t/s são ~84. O tempo limite acompanha
# o perfil por isso mesmo.
#
# LLM_PROVIDER=groq
# LLM_API_KEY=
#
#
# Para a Cerebras, a opção mais rápida:
# LLM_PROVIDER=cerebras
# LLM_API_KEY=csk-...
#
# Para a DeepSeek, descomentar as três:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-...
#
# E para afinar peça a peça, se for preciso:
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_MODEL_FALLBACK=
# LLM_MODEL_VISION=
# LLM_TIMEOUT_MS=
