+  .ring-blue\/30 { --tw-ring-color: var(--accent-border); }
+  .focus\:ring-blue\/30:focus { --tw-ring-color: var(--accent-border); }
+  .focus\:border-blue:focus   { border-color: var(--accent); }
+
+  /* Placeholder */
+  .placeholder-ink-tertiary::placeholder { color: var(--text-muted); }
+
+  /* ── Overrides hover para NavBar e dropdowns ──
+     Selectors com :hover precisam de ser declarados explicitamente
+     porque têm especificidade diferente dos utilitários base.       */
+  .hover\:bg-surface-subtle:hover { background-color: var(--accent-alpha-05); }
+  .hover\:text-ink:hover          { color: var(--text-primary); }
+
+  /* ── Shadows Mercado ──
+     shadow-card e shadow-card-md: subtom índigo em vez de cinzento. */
+  .shadow-card    {
+    --tw-shadow: 0 1px 4px rgba(26,14,46,0.07), 0 4px 12px rgba(26,14,46,0.05);
+    box-shadow: var(--tw-ring-offset-shadow,0 0 #0000),
+                var(--tw-ring-shadow,0 0 #0000),
+                var(--tw-shadow);
+  }
+  .shadow-card-md {
+    --tw-shadow: 0 2px 8px rgba(26,14,46,0.09), 0 8px 24px rgba(26,14,46,0.07);
+    box-shadow: var(--tw-ring-offset-shadow,0 0 #0000),
+                var(--tw-ring-shadow,0 0 #0000),
+                var(--tw-shadow);
+  }
+
+  /* ── Hover variants do accent ── */
+  .hover\:text-blue:hover  { color: var(--accent); }
+  .hover\:bg-blue:hover    { background-color: var(--accent); }
+
+  /* ── Frosted-glass nav bars (bg-surface/90, bg-surface/95) ──
+     Tailwind gera estes como background-color estático com --tw-bg-opacity.
+     Overrides aqui garantem que a nav usa o tom Mercado correcto.        */
+  .bg-surface\/90  { background-color: var(--bg-card-90); }
+  .bg-surface\/95  { background-color: var(--bg-card-95); }
 }
