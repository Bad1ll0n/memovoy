NODE_ENV=development
PORT=4000

# PostgreSQL — obrigatório, a API não arranca sem isto
DATABASE_URL=postgresql://postgres:password@localhost:5432/insight

# JWT — ambos obrigatórios, a API recusa arrancar se faltar algum
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=another-secret-min-32-chars

# LLM — o cliente aponta para a API da Groq (compatível com o SDK da OpenAI).
# Obrigatório: sem isto o módulo aiAgent.js rebenta logo no import.
GROQ_API_KEY=gsk_...

# Redis — opcional. Sem isto o Socket.IO corre em modo single-node,
# suficiente para desenvolvimento local.
# REDIS_URL=redis://localhost:6379

# AWS S3
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=insight-uploads

# Endpoint S3 alternativo — usar com o MinIO do docker-compose.yml.
# Deixar vazio para usar a AWS real.
# S3_ENDPOINT=http://localhost:9000

# Frontend URL (para CORS + links de email). Aceita lista separada por vírgulas.
FRONTEND_URL=http://localhost:3000

# IP do proxy de confiança para X-Forwarded-For (o do load balancer, em produção).
# Sem isto o cabeçalho é ignorado, o que evita spoofing de IP.
# TRUSTED_PROXY=10.0.0.1

# OpenTelemetry — desligado por omissão para não poluir o dev local.
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=memovoy-api

# VAPID (Web Push — gerar com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@memovoy.com

# SMTP (opcional — sem isto os links de verificação vão para a consola)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM=Memovoy <noreply@memovoy.app>
