NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/insight

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_REFRESH_SECRET=another-secret-min-32-chars

# OpenAI
OPENAI_API_KEY=sk-...

# AWS S3
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=insight-uploads

# Frontend URL (for CORS + email links)
FRONTEND_URL=http://localhost:3000

# Trusted proxy IP for X-Forwarded-For (set to load balancer IP in production)
# TRUSTED_PROXY=10.0.0.1

# VAPID (Web Push Notifications — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@memovoy.com

# SMTP (optional — if not set, verification links are logged to console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
EMAIL_FROM=Memovoy <noreply@memovoy.app>
