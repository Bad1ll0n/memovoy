# Normaliza line endings: LF no repositório, nativo no disco.
* text=auto eol=lf

# Binários — nunca converter.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary

# Scripts Windows precisam de CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
