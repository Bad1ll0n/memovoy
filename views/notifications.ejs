<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <script>(function(){var t=localStorage.getItem('insight-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%- t('notifications.title') %> | Insight</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/notifications.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

<div class="container-fluid px-4">
    <div class="row">

        <!-- SIDEBAR -->
        <div class="col-lg-2 d-none d-lg-block">
            <a href="/dashboard" class="sidebar-brand"><i class="fa-solid fa-compass"></i> INSIGHT</a>

            <div class="sidebar-title"><%- t('sidebar.discover') %></div>
            <a href="/dashboard" class="menu-item"><i class="fa-regular fa-compass"></i> <%- t('nav.feed') %></a>
            <a href="/users" class="menu-item"><i class="fa-solid fa-magnifying-glass"></i> <%- t('nav.search') %></a>
            <a class="menu-item" href="#"><i class="fa-solid fa-plus me-1"></i> <%- t('nav.newTrip') %></a>
            <a href="#" class="menu-item"><i class="fa-solid fa-arrow-trend-up"></i> <%- t('nav.trending') %></a>

            <div class="sidebar-title"><%- t('sidebar.personal') %></div>
            <a href="/favorites" class="menu-item"><i class="fa-regular fa-heart"></i> <%- t('nav.favorites') %></a>
            <a href="#" class="menu-item"><i class="fa-regular fa-bookmark"></i> <%- t('nav.saved') %></a>
            <a href="/notifications" class="menu-item active">
                <i class="fa-regular fa-bell"></i> <%- t('nav.notifications') %>
            </a>
            <a href="/messages" class="menu-item">
                <i class="fa-regular fa-envelope"></i> <%- t('nav.messages') %>
                <% if (locals.unreadMessages && unreadMessages > 0) { %>
                    <span class="badge-custom"><%= unreadMessages %></span>
                <% } %>
            </a>

            <div class="sidebar-title"><%- t('sidebar.other') %></div>
            <a href="#" class="menu-item"><i class="fa-solid fa-users"></i> <%- t('nav.community') %></a>
            <a href="/settings" class="menu-item"><i class="fa-solid fa-gear"></i> <%- t('nav.settings') %></a>

            <div class="menu-item">
                <a href="/profile" class="menu-item-username d-flex align-items-center text-decoration-none" style="gap:12px;">
                    <img src="<%= user.Avatar_Url || '/assets/images/default-avatar.jpg' %>"
                        class="rounded-circle border border-secondary" width="38" height="38"
                        style="object-fit:cover;" alt="<%= user.Name %>">
                    <span style="color:inherit;font-size:inherit;"><%= user.Name %></span>
                </a>
            </div>
        </div>

        <!-- MAIN -->
        <div class="col-lg-6 col-md-10 mx-auto mt-4">

            <div class="notif-header">
                <h2 class="notif-title"><%- t('notifications.title') %></h2>
                <% if (notifications.length > 0) { %>
                    <span class="notif-count"><%= notifications.length %></span>
                <% } %>
            </div>

            <% if (notifications.length === 0) { %>
                <div class="notif-empty">
                    <i class="fa-regular fa-bell"></i>
                    <p><%- t('notifications.empty') %></p>
                </div>
            <% } else { %>
                <div class="notif-list">
                    <% notifications.forEach(function(n) { %>
                        <%
                        var icon, label, link;
                        if (n.type === 'like') {
                            icon  = 'fa-heart notif-icon--like';
                            label = t('notifications.liked');
                            link  = '#';
                        } else if (n.type === 'comment') {
                            icon  = 'fa-comment notif-icon--comment';
                            label = t('notifications.commented') + ' ' + (n.message || '');
                            link  = '#';
                        } else {
                            icon  = 'fa-user-plus notif-icon--follow';
                            label = t('notifications.followed');
                            link  = '/u/' + n.actor_id;
                        }
                        var timeAgo = new Date(n.created_at).toLocaleDateString('pt-PT', { day:'2-digit', month:'short', hour:'2-digit', minute:'2-digit' });
                        %>
                        <a href="<%= link %>" class="notif-item <%= n.read ? '' : 'unread' %>">
                            <div class="notif-avatar-wrap">
                                <img src="<%= n.actor_avatar || '/assets/images/default-avatar.jpg' %>"
                                    onerror="this.src='/assets/images/default-avatar.jpg'">
                                <span class="notif-type-icon">
                                    <i class="fa-solid <%= icon %>"></i>
                                </span>
                            </div>
                            <div class="notif-body">
                                <span class="notif-actor"><%= n.actor_name %></span>
                                <span class="notif-action"> <%= label %></span>
                                <div class="notif-time"><%= timeAgo %></div>
                            </div>
                            <% if (!n.read) { %>
                                <span class="notif-dot"></span>
                            <% } %>
                        </a>
                    <% }) %>
                </div>
            <% } %>

        </div>
    </div>
</div>

<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/theme.js"></script>
</body>
</html>
