<!DOCTYPE html>
<html lang="pt">

<head>
  <meta charset="UTF-8">
  <script>(function(){var t=localStorage.getItem('insight-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= itinerary.title %> — Insight
  </title>
  <link
    href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/itinarary.css" />
  <link rel="stylesheet" href="/css/theme.css" />

</head>

<body>

  <div class="hero">
    <div class="hero-badge"><i class="fa-solid fa-wand-magic-sparkles"></i> <%- t('itinerary.generatedByAI') %></div>
    <h1>
      <%= itinerary.title %>
    </h1>
    <p class="hero-summary">
      <%= itinerary.summary %>
    </p>
    <div class="hero-meta">
      <span><i class="fa-solid fa-location-dot"></i>
        <%= itinerary.destinationInfo.normalizedName %>, <%= itinerary.destinationInfo.country %>
      </span>
      <span><i class="fa-regular fa-calendar"></i>
        <%= itinerary.params.departureDate %> → <%= itinerary.params.returnDate %>
      </span>
      <span><i class="fa-solid fa-users"></i>
        <%= itinerary.params.group %>
      </span>
      <span><i class="fa-solid fa-euro-sign"></i> ~<%= itinerary.params.budget %>/dia</span>
      <span><i class="fa-solid fa-coins"></i> <%- t('itinerary.totalEstimated') %> <%= itinerary.totalEstimatedCost %></span>
    </div>
  </div>

  <div class="page-wrap">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <a href="/dashboard" class="btn-back"><i class="fa-solid fa-arrow-left"></i> <%- t('itinerary.backToFeed') %></a>
      <div class="d-flex gap-2 align-items-center">
        <button class="btn-print" id="printBtn"><i class="fa-solid fa-print"></i> <%- t('itinerary.printPdf') %></button>
        <% if (isOwner) { %>
          <% if (!itinerary.saved) { %>
            <button class="btn-save-itinerary" id="saveItineraryBtn">
              <i class="fa-solid fa-floppy-disk"></i> <%- t('itinerary.saveItinerary') %>
            </button>
          <% } else { %>
            <span class="btn-saved">
              <i class="fa-solid fa-circle-check"></i> <%- t('itinerary.saved') %>
            </span>
            <button class="btn-edit-mode" id="editModeBtn">
              <i class="fa-solid fa-pen-to-square"></i> <%- t('itinerary.edit') %>
            </button>
            <button class="btn-save-edit" id="saveEditBtn" style="display:none;">
              <i class="fa-solid fa-floppy-disk"></i> <%- t('itinerary.saveChanges') %>
            </button>
            <button class="btn-cancel-edit" id="cancelEditBtn" style="display:none;">
              <%- t('itinerary.cancel') %>
            </button>
          <% } %>
        <% } %>
        <% if (itinerary.saved) { %>
          <button class="btn-share-itinerary" id="shareItineraryBtn">
            <i class="fa-solid fa-share-nodes"></i> <%- t('itinerary.share') %>
          </button>
        <% } %>
      </div>
    </div>

    <!-- Destination info bar -->
    <div class="dest-bar">
      <div class="dest-item">
        <div class="label"><%- t('itinerary.country') %></div>
        <div class="val">
          <%= itinerary.destinationInfo.country %>
        </div>
      </div>
      <div class="dest-item">
        <div class="label"><%- t('itinerary.currency') %></div>
        <div class="val">
          <%= itinerary.destinationInfo.currency %>
        </div>
      </div>
      <div class="dest-item">
        <div class="label"><%- t('itinerary.language') %></div>
        <div class="val">
          <%= itinerary.destinationInfo.language %>
        </div>
      </div>
      <div class="dest-item">
        <div class="label"><%- t('itinerary.timezone') %></div>
        <div class="val">
          <%= itinerary.destinationInfo.timezone %>
        </div>
      </div>
      <div class="dest-item">
        <div class="label"><%- t('itinerary.bestTime') %></div>
        <div class="val">
          <%= itinerary.destinationInfo.bestTimeToVisit %>
        </div>
      </div>
    </div>

    <!-- Quick facts -->
    <% if (itinerary.destinationInfo.quickFacts && itinerary.destinationInfo.quickFacts.length> 0) { %>
      <div class="section-title"><i class="fa-solid fa-circle-info"></i> <%- t('itinerary.quickFacts') %></div>
      <div class="d-flex flex-wrap gap-2 mb-4">
        <% itinerary.destinationInfo.quickFacts.forEach(fact=> { %>
          <span
            style="background:var(--card);border:1px solid var(--border);border-radius:99px;padding:6px 14px;font-size:.8rem;color:var(--muted);">
            <%= fact %>
          </span>
          <% }) %>
      </div>
      <% } %>

        <!-- Edit mode banner -->
        <% if (itinerary.saved) { %>
          <div class="edit-mode-banner" id="editModeBanner">
            <i class="fa-solid fa-pen-to-square"></i>
            <%- t('itinerary.editModeActive') %>
          </div>
          <% } %>

            <!-- Day tabs -->
            <div class="section-title"><i class="fa-regular fa-calendar-days"></i> <%- t('itinerary.itineraryTitle') %></div>

            <div class="day-tabs" id="dayTabs">
              <% itinerary.days.forEach((day, i)=> { %>
                <button class="day-tab <%= i === 0 ? 'active' : '' %>" data-day="<%= i %>">
                  Dia <%= day.dayNumber %>
                </button>
                <% }) %>
            </div>

            <!-- Day panels -->
            <% itinerary.days.forEach((day, i)=> { %>
              <div class="day-panel <%= i === 0 ? 'active' : '' %>" id="day-panel-<%= i %>">
                <div class="day-header">
                  <div>
                    <div class="day-theme"><i class="fa-solid fa-tag me-1"></i>
                      <%= day.theme %>
                    </div>
                    <h3>
                      <%= day.title %>
                    </h3>
                    <div class="day-highlight"><i class="fa-solid fa-star text-warning"></i>
                      <%= day.highlight %>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-3">
                    <div class="day-cost"><i class="fa-solid fa-coins me-1"></i>
                      <%= day.totalDayCost %>
                    </div>
                    <button class="btn-day-map" data-day-index="<%= i %>"
                      onclick="openDayMap(parseInt(this.dataset.dayIndex))" title="<%- t('itinerary.dayRoute') %>">
                      <i class="fa-solid fa-map-location-dot"></i> <%- t('itinerary.map') %>
                    </button>
                  </div>
                </div>

                <div class="activity-list" id="act-list-<%= i %>">
                  <% day.activities.forEach((act, actIdx)=> { %>
                    <div class="activity-item" draggable="true" data-day-index="<%= i %>"
                      data-act-index="<%= actIdx %>">
                      <div class="act-time" id="act-time-<%= i %>-<%= actIdx %>">
                        <%= act.time %>
                      </div>
                      <div class="act-dot"></div>
                      <div class="act-card">
                        <div class="drag-handle"><i class="fa-solid fa-grip-lines"></i> <%- t('itinerary.dragToMove') %></div>
                        <div class="act-header">
                          <span class="act-name">
                            <%= act.name %>
                          </span>
                          <span class="act-type-badge type-<%= act.type %>">
                            <%= act.type %>
                          </span>
                        </div>
                        <div class="act-desc">
                          <%= act.description %>
                        </div>
                        <div class="act-meta">
                          <% if (act.duration) { %><span class="act-dur-label" id="dur-label-<%= i %>-<%= actIdx %>"><i
                                class="fa-regular fa-clock"></i>
                              <%= act.duration %>
                            </span>
                            <% } %>
                              <% if (act.estimatedCost) { %><span><i class="fa-solid fa-euro-sign"></i>
                                  <%= act.estimatedCost %>
                                </span>
                                <% } %>
                        </div>
                        <% if (act.tip) { %>
                          <div class="act-tip"><i class="fa-solid fa-lightbulb"></i>
                            <%= act.tip %>
                          </div>
                          <% } %>
                            <!-- Popup editar duração -->
                            <div class="dur-edit-popup" id="dur-popup-<%= i %>-<%= actIdx %>">
                              <label><%- t('itinerary.durationLabel') %></label>
                              <input type="text" class="dur-input-text" id="dur-text-<%= i %>-<%= actIdx %>"
                                value="<%= act.duration || '1h' %>" placeholder="ex: 2h, 1h30, 45min">
                              <button class="btn-save-dur" data-day="<%= i %>" data-act="<%= actIdx %>">Guardar</button>
                              <button class="btn-cancel-dur" data-day="<%= i %>" data-act="<%= actIdx %>">✕</button>
                            </div>
                            <div class="act-actions">
                              <button class="btn-edit-dur" data-day="<%= i %>" data-act="<%= actIdx %>">
                                <i class="fa-solid fa-hourglass-half"></i> <%- t('itinerary.editDuration') %>
                              </button>
                              <button class="btn-swap" data-day-index="<%= i %>" data-act-index="<%= actIdx %>">
                                <i class="fa-solid fa-shuffle"></i> <%- t('itinerary.swapActivity') %>
                              </button>
                            </div>
                      </div>
                    </div>
                    <% }) %>
                </div>
              </div>
              <% }) %>

                <!-- Tips section -->
                <% if (itinerary.extraTips) { %>
                  <div class="section-title mt-5"><i class="fa-solid fa-compass"></i> <%- t('itinerary.essentialTips') %></div>
                  <div class="tips-grid">
                    <% if (itinerary.extraTips.safetyTips) { %>
                      <div class="tip-card">
                        <h6>🛡️ <%- t('itinerary.tipSafety') %></h6>
                        <ul>
                          <% itinerary.extraTips.safetyTips.forEach(t=> { %><li>
                              <%= t %>
                            </li>
                            <% }) %>
                        </ul>
                      </div>
                      <% } %>
                        <% if (itinerary.extraTips.transportTips) { %>
                          <div class="tip-card">
                            <h6>🚌 <%- t('itinerary.tipTransport') %></h6>
                            <ul>
                              <% itinerary.extraTips.transportTips.forEach(t=> { %><li>
                                  <%= t %>
                                </li>
                                <% }) %>
                            </ul>
                          </div>
                          <% } %>
                            <% if (itinerary.extraTips.budgetHacks) { %>
                              <div class="tip-card">
                                <h6>💸 <%- t('itinerary.tipSaveMoney') %></h6>
                                <ul>
                                  <% itinerary.extraTips.budgetHacks.forEach(t=> { %><li>
                                      <%= t %>
                                    </li>
                                    <% }) %>
                                </ul>
                              </div>
                              <% } %>
                                <% if (itinerary.extraTips.mustTry) { %>
                                  <div class="tip-card">
                                    <h6>⭐ <%- t('itinerary.tipMustTry') %></h6>
                                    <ul>
                                      <% itinerary.extraTips.mustTry.forEach(t=> { %><li>
                                          <%= t %>
                                        </li>
                                        <% }) %>
                                    </ul>
                                  </div>
                                  <% } %>
                  </div>
                  <% } %>

                    <!-- Packing tips -->
                    <% if (itinerary.packingTips && itinerary.packingTips.length> 0) { %>
                      <div class="section-title mt-4"><i class="fa-solid fa-suitcase"></i> <%- t('itinerary.whatToPack') %></div>
                      <div class="d-flex flex-wrap gap-2 mb-4">
                        <% itinerary.packingTips.forEach(tip=> { %>
                          <span
                            style="background:var(--card);border:1px solid var(--border);border-radius:8px;padding:8px 14px;font-size:.82rem;color:var(--muted);">
                            🎒 <%= tip %>
                          </span>
                          <% }) %>
                      </div>
                      <% } %>

                        <!-- Local phrases -->
                        <% if (itinerary.localPhrases && itinerary.localPhrases.length> 0) { %>
                          <div class="section-title mt-4"><i class="fa-solid fa-language"></i> <%- t('itinerary.usefulPhrases') %></div>
                          <div class="phrases-grid mb-5">
                            <% itinerary.localPhrases.forEach(p=> { %>
                              <div class="phrase-card">
                                <div class="phrase-original">
                                  <%= p.phrase %>
                                </div>
                                <div class="phrase-translation">
                                  <%= p.translation %>
                                </div>
                                <div class="phrase-pronunciation">"<%= p.pronunciation %>"</div>
                              </div>
                              <% }) %>
                          </div>
                          <% } %>

  </div><!-- /page-wrap -->

  <!-- ── MODAL PARTILHAR ROTEIRO ── -->
  <div class="share-modal-overlay" id="shareModalOverlay">
    <div class="share-modal">
      <h3><i class="fa-solid fa-share-nodes" style="color:#60a5fa;margin-right:8px"></i><%- t('itinerary.shareItinerary') %></h3>
      <p><%- t('itinerary.shareCommunity') %></p>

      <!-- Preview do roteiro -->
      <div class="share-itinerary-preview">
        <i class="fa-solid fa-map-location-dot"></i>
        <div class="share-preview-info">
          <div class="title" id="sharePreviewTitle">—</div>
          <div class="meta" id="sharePreviewMeta">—</div>
        </div>
      </div>

      <div class="share-error" id="shareError"></div>
      <div class="share-success" id="shareSuccess"></div>

      <div class="share-desc-label"><%- t('itinerary.descOptional') %> <span style="color:var(--muted);font-weight:400">(<%- t('common.comingSoon').toLowerCase() %>)</span></div>
      <textarea class="share-desc-textarea" id="shareDescInput"
        placeholder="<%- t('shareModal.descPlaceholder') %>"></textarea>

      <div class="share-photos-label"><%- t('itinerary.photosOptional') %> <span style="color:var(--muted);font-weight:400">(<%- t('common.comingSoon').toLowerCase() %>, max. 10)</span>
      </div>
      <input type="file" class="share-photos-input" id="sharePhotosInput" accept="image/*" multiple>
      <div class="share-photos-preview" id="sharePhotosPreview"></div>

      <div class="share-modal-actions">
        <button class="btn-share-cancel" id="shareCancelBtn"><%- t('itinerary.cancel') %></button>
        <button class="btn-share-confirm" id="shareConfirmBtn">
          <i class="fa-solid fa-share-nodes"></i> <%- t('itinerary.confirmShare') %>
        </button>
      </div>
    </div>
  </div>

  <!-- ── MODAL GUARDAR ROTEIRO ── -->
  <div class="save-modal-overlay" id="saveModalOverlay">
    <div class="save-modal">
      <h3><i class="fa-solid fa-floppy-disk" style="color:var(--accent);margin-right:8px"></i><%- t('itinerary.saveTitle') %></h3>
      <p><%- t('itinerary.saveNameDesc') %></p>
      <div class="save-error" id="saveError"></div>
      <input type="text" class="save-title-input" id="saveTitleInput" maxlength="200"
        placeholder="<%- t('itinerary.saveTitlePlaceholder') %>">
      <div class="save-char-count"><span id="saveCharCount">0</span>/200</div>
      <div class="save-modal-actions">
        <button class="btn-save-cancel" id="saveCancelBtn"><%- t('itinerary.cancel') %></button>
        <button class="btn-save-confirm" id="saveConfirmBtn">
          <i class="fa-solid fa-floppy-disk"></i> <%- t('itinerary.confirmSave') %>
        </button>
      </div>
    </div>
  </div>

  <!-- ── PAINEL DE SUGESTÕES ── -->
  <div class="suggestions-overlay" id="suggestionsOverlay">
    <div class="suggestions-panel" id="suggestionsPanel">

      <div class="suggestions-header">
        <div>
          <h5><i class="fa-solid fa-shuffle" style="color:var(--accent);margin-right:6px"></i><%- t('itinerary.alternatives') %></h5>
          <small style="color:var(--muted);font-size:.78rem"><%- t('itinerary.chooseOption') %></small>
        </div>
        <button class="btn-close-panel" id="closeSuggestionsBtn">✕</button>
      </div>

      <div class="current-activity-badge">
        <div class="label"><%- t('itinerary.currentActivity') %></div>
        <div class="name" id="currentActivityName">—</div>
      </div>

      <!-- Loading -->
      <div class="suggestions-loading" id="suggestionsLoading">
        <div class="sugg-spinner"></div>
        <div style="font-size:.85rem"><%- t('itinerary.generatingAlts') %></div>
      </div>

      <!-- Lista de alternativas -->
      <div id="alternativesList" style="display:none"></div>

      <!-- Botão confirmar -->
      <button class="btn-confirm-swap" id="confirmSwapBtn">
        <i class="fa-solid fa-check me-2"></i><%- t('itinerary.confirmSwap') %>
      </button>

    </div>
  </div>

  <!-- MAP MODAL -->
  <div class="map-modal-overlay" id="mapModalOverlay">
    <div class="map-modal">
      <div class="map-modal__header">
        <h3 class="map-modal__title" id="mapModalTitle"><%- t('itinerary.dayRoute') %></h3>
        <button class="map-modal__close" onclick="closeMapModal()"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="map-modal__body">
        <div class="map-loading" id="mapLoading">
          <i class="fa-solid fa-circle-notch"></i>
          <span><%- t('itinerary.mapLoading') %></span>
          <small style="color:#5c7080;font-size:.75rem;">Pode demorar alguns segundos</small>
        </div>
        <div id="dayMapContainer" style="display:none;"></div>
      </div>
    </div>
  </div>

  <!-- Passa o itineraryId para o JS -->

  <script>
    window.ITINERARY_ID = '<%= itinerary.id %>';
    window.ITINERARY_SAVED = '<%= itinerary.saved %>' === 'true';
    window.ITINERARY_DESTINATION = '<%= itinerary.destinationInfo.normalizedName %>, <%= itinerary.destinationInfo.country %>';
    window._itin = {
        saveChanges: '<%- t("itinerary.saveChanges") %>',
        titleRequiredMsg: '<%- t("itinerary.saveNameDesc") %>',
        errorSuggest: '<%- t("common.error") %>',
        noLocations: '<%- t("common.error") %>',
        typeVisit:     '<%- t("manualRoteiro.typeVisit") %>',
        typeMeal:      '<%- t("manualRoteiro.typeMeal") %>',
        typeTransport: '<%- t("manualRoteiro.typeTransport") %>',
        typeLeisure:   '<%- t("manualRoteiro.typeLeisure") %>',
        typeAccom:     '<%- t("manualRoteiro.typeAccommodation") %>'
    };
  </script>
  <div id="itinerary-data" style="display:none">
    <%= JSON.stringify(itinerary.days || []) %>
  </div>


  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/vendor/bootstrap/js/bootstrap.min.js"></script>
  <script src="/js/itinerary.js"></script>
  <script src="/js/theme.js"></script>
</body>

</html>