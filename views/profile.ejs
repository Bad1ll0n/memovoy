<%
let coverImage = 'https://images.unsplash.com/photo-1516483638261-f4dbaf036963?q=80&w=2000';
if (user.Header_Url && user.Header_Url.length > 0) { coverImage = user.Header_Url; }
const joinDate = new Date(user.created_at || Date.now()).toLocaleDateString('pt-PT', { month: 'long', year: 'numeric' });

const badges = [
    { title: 'Summit Seeker',  desc: 'Visited 10+ mountain destinations', icon: 'fa-mountain-sun',    unlocked: true  },
    { title: 'Beach Explorer', desc: 'Explored 15+ coastal paradises',    icon: 'fa-umbrella-beach',  unlocked: true  },
    { title: 'Urban Nomad',    desc: 'Discovered 20+ major cities',       icon: 'fa-city',            unlocked: true  },
    { title: 'Wild Camper',    desc: '5+ wilderness camping trips',       icon: 'fa-tent',            unlocked: true  },
    { title: 'Globe Trotter',  desc: 'Visited 25+ countries',             icon: 'fa-globe',           unlocked: false },
    { title: 'Story Teller',   desc: 'Created 50+ travel posts',          icon: 'fa-camera',          unlocked: false }
];
%>
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <script>(function(){var t=localStorage.getItem('insight-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Insight | <%= user.Name %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

<!-- NAVBAR -->
<nav class="pf-nav">
    <a class="pf-nav__brand" href="/dashboard">
        <i class="fa-solid fa-compass"></i> INSIGHT
    </a>
    <div class="pf-nav__links" style="position:absolute;left:50%;transform:translateX(-50%);">
        <a href="/dashboard"><i class="fa-solid fa-house-chimney"></i> Home</a>
        <a href="#" data-bs-toggle="modal" data-bs-target="#createItineraryModal">
            <i class="fa-solid fa-plus"></i> New Trip
        </a>
        <a href="#" data-bs-toggle="modal" data-bs-target="#sharePhotoModal">
            <i class="fa-regular fa-image"></i> New Post
        </a>
        <a href="/profile_trips" class="pf-nav__link--accent">
            <i class="fa-solid fa-heart"></i> My Trips
        </a>
    </div>
    <div class="pf-nav__right">
        <i class="fa-regular fa-bell pf-nav__bell"></i>
        <div class="dropdown">
            <img src="<%= user.Avatar_Url || '/assets/images/default-avatar.jpg' %>"
                class="pf-nav__avatar" role="button" data-bs-toggle="dropdown">
            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                <li><a class="dropdown-item" href="/profile"><%- t('nav.profile') %></a></li>
                <li><a class="dropdown-item" href="/profile/edit"><%- t('nav.editProfile') %></a></li>
                <li><a class="dropdown-item" href="/settings"><i class="fa-solid fa-gear me-2"></i><%- t('nav.settings') %></a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/logout"><%- t('nav.logout') %></a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- COVER -->
<div class="pf-cover" style="background-image: url('<%= coverImage %>'); margin-top: 60px;"></div>

<!-- PROFILE HEADER -->
<div class="pf-header">
    <div class="pf-header__inner">
        <img src="<%= user.Avatar_Url || '/assets/images/default-avatar.jpg' %>"
            class="pf-avatar" alt="<%= user.Name %>"
            onerror="imgFallback(this)">

        <div class="pf-info">
            <h1 class="pf-info__name"><%= user.Name %></h1>
            <div class="pf-info__username">@<%= user.Username %></div>
            <div class="pf-info__meta">
                <% if (user.Location) { %>
                    <span><i class="fa-solid fa-location-dot"></i> <%= user.Location %></span>
                <% } %>
                <span><i class="fa-regular fa-calendar"></i> Joined <%= joinDate %></span>
            </div>
            <p class="pf-info__bio">
                <% if (user.Bio) { %>
                    <%= user.Bio %>
                <% } else { %>
                    <em style="opacity:.5">No bio yet. Tell the world about your travels!</em>
                <% } %>
            </p>
        </div>

        <div class="pf-actions">
            <a href="/profile/edit" class="pf-btn pf-btn--outline">
                <i class="fa-solid fa-gear"></i> Edit Profile
            </a>
            <button class="pf-btn pf-btn--icon">
                <i class="fa-solid fa-share-nodes"></i>
            </button>
        </div>
    </div>
</div>

<!-- MAIN -->
<div class="pf-main">

    <!-- STATS -->
    <div class="pf-stats">
        <div class="pf-stat active">
            <i class="fa-solid fa-globe"></i>
            <div class="pf-stat__value">28</div>
            <div class="pf-stat__label">Countries</div>
        </div>
        <div class="pf-stat">
            <i class="fa-solid fa-route"></i>
            <div class="pf-stat__value"><%= posts.length %></div>
            <div class="pf-stat__label">Posts</div>
        </div>
        <div class="pf-stat">
            <i class="fa-solid fa-heart"></i>
            <div class="pf-stat__value"><%= following || 0 %></div>
            <div class="pf-stat__label">Following</div>
        </div>
        <div class="pf-stat">
            <i class="fa-solid fa-users"></i>
            <div class="pf-stat__value" id="followersCount"><%= followers || 0 %></div>
            <div class="pf-stat__label">Followers</div>
        </div>
        <div class="pf-stat">
            <i class="fa-solid fa-award"></i>
            <div class="pf-stat__value">12</div>
            <div class="pf-stat__label">Badges</div>
        </div>
    </div>

    <!-- TRAVEL EXPERIENCE -->
    <div class="pf-section-header">
        <h2 class="pf-section-title">Travel <span>Experience</span></h2>
        <a href="#" class="pf-section-link">View all badges <i class="fa-solid fa-chevron-right fa-xs ms-1"></i></a>
    </div>
    <div class="pf-badges">
        <% badges.forEach(b => { %>
        <div class="pf-badge">
            <div class="pf-badge__icon <%= b.unlocked ? '' : 'locked' %>">
                <i class="fa-solid <%= b.icon %>"></i>
            </div>
            <div class="pf-badge__title"><%= b.title %></div>
            <div class="pf-badge__desc"><%= b.desc %></div>
        </div>
        <% }) %>
    </div>

    <!-- TABS -->
    <div class="pf-tabs">
        <a class="pf-tab active" href="#" data-tab="posts">
            Posts <span class="pf-tab__count"><%= posts.length %></span>
        </a>
        <a class="pf-tab" href="#" data-tab="favorites">
            Favorites <span class="pf-tab__count" id="favCount">—</span>
        </a>
        <a class="pf-tab" href="#" data-tab="saved">
            Saved <span class="pf-tab__count">—</span>
        </a>
    </div>

    <!-- POSTS TAB -->
    <div id="tab-posts">
    <% if (posts.length === 0) { %>
        <div class="pf-empty">
            <i class="fa-solid fa-images"></i>
            <p>You haven't shared anything yet.<br>Share your first travel experience!</p>
            <a href="#" class="pf-empty__btn" data-bs-toggle="modal" data-bs-target="#sharePhotoModal">
                <i class="fa-solid fa-plus"></i> Create Post
            </a>
        </div>
    <% } else { %>
        <div class="pf-grid">
            <% posts.forEach(post => {
                const photos = Array.isArray(post.PHOTOS_URLS) ? post.PHOTOS_URLS : (post.PHOTOS_URLS ? [post.PHOTOS_URLS] : []);
                const cover  = photos[0] || null;
            %>
            <div class="pf-post"
                data-post-id="<%= post.G_POST_ID %>"
                data-photos='<%- JSON.stringify(photos) %>'
                data-desc="<%= (post.T_DESC || '').replace(/"/g, '&quot;') %>"
                data-likes="<%= post.N_LIKES || 0 %>"
                data-comments="<%= post.N_COMMENTS || 0 %>"
                data-roteiro="<%= post.T_NOME || '' %>"
                data-destination="<%= post.DESTINATION || '' %>"
                data-date="<%= post.D_CREATE_DATE ? new Date(post.D_CREATE_DATE).toLocaleDateString('pt-PT') : '' %>"
                data-liked="<%= post.user_has_liked ? '1' : '0' %>"
                onclick="openPostModal(this)">

                <div class="pf-post__img-wrap">
                    <% if (cover) { %>
                        <img src="<%= cover %>" alt="post" onerror="this.parentNode.innerHTML='<div class=pf-post__img-placeholder><i class=fa-solid fa-image></i></div>'">
                    <% } else { %>
                        <div class="pf-post__img-placeholder"><i class="fa-solid fa-image"></i></div>
                    <% } %>
                    <% if (photos.length > 1) { %>
                        <span class="pf-post__count"><i class="fa-solid fa-images"></i> <%= photos.length %></span>
                    <% } %>
                </div>

                <div class="pf-post__body">
                    <% if (post.T_NOME) { %>
                        <div class="pf-post__route"><i class="fa-solid fa-route"></i> <%= post.T_NOME %></div>
                    <% } %>
                    <div class="pf-post__title">
                        <%= post.T_DESC ? post.T_DESC.substring(0,65) + (post.T_DESC.length > 65 ? '…' : '') : 'No description' %>
                    </div>
                    <% if (post.DESTINATION) { %>
                        <div class="pf-post__location">
                            <i class="fa-solid fa-location-dot"></i> <%= post.DESTINATION %>
                        </div>
                    <% } %>
                    <div class="pf-post__footer">
                        <div class="pf-post__stats">
                            <span><i class="fa-solid fa-heart"></i> <%= post.N_LIKES || 0 %></span>
                            <span><i class="fa-regular fa-comment"></i> <%= post.N_COMMENTS || 0 %></span>
                        </div>
                        <i class="fa-regular fa-bookmark" style="color:var(--muted);font-size:.9rem;cursor:pointer;"></i>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    <% } %>
    </div>

    <!-- FAVORITES TAB -->
    <div id="tab-favorites" style="display:none;">
        <div id="favoritesContent">
            <div class="pf-empty">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <p>Loading favorites...</p>
            </div>
        </div>
    </div>

</div><!-- /pf-main -->

<footer class="pf-footer">&copy; 2024 Insight Travel. Made for explorers.</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/notifications-rt.js"></script>

<!-- POST DETAIL MODAL -->
<div class="modal fade" id="postDetailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" style="max-width:1100px; width:95vw;">
    <div class="modal-content border-0" style="background:var(--bg-card,var(--card)); border-radius:14px; overflow:hidden;">
      <div class="row g-0" style="min-height:640px; max-height:90vh;">

        <!-- Foto(s) -->
        <div class="col-md-7 d-flex align-items-center justify-content-center" style="background:var(--bg,#0b0e14); position:relative; min-height:400px;">
          <button onclick="prevPhoto()" id="btnPrev" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.6);border:none;color:#fff;width:40px;height:40px;border-radius:50%;display:none;cursor:pointer;z-index:10;align-items:center;justify-content:center;">
            <i class="fa-solid fa-chevron-left"></i>
          </button>
          <img id="modalPhoto" src="" alt="post" style="max-height:640px;width:100%;height:100%;object-fit:contain;">
          <button onclick="nextPhoto()" id="btnNext" style="position:absolute;right:12px;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.6);border:none;color:#fff;width:40px;height:40px;border-radius:50%;display:none;cursor:pointer;z-index:10;align-items:center;justify-content:center;">
            <i class="fa-solid fa-chevron-right"></i>
          </button>
          <span id="photoCounter" style="position:absolute;bottom:14px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.65);color:#fff;font-size:.75rem;padding:4px 12px;border-radius:20px;display:none;"></span>
        </div>

        <!-- Info + comentários -->
        <div class="col-md-5 d-flex flex-column" style="border-left:1px solid var(--border); overflow:hidden;">
          <div class="d-flex align-items-center justify-content-between p-3" style="border-bottom:1px solid var(--border); flex-shrink:0;">
            <div class="d-flex align-items-center gap-2">
              <img src="<%= user.Avatar_Url || '/assets/images/default-avatar.jpg' %>" class="rounded-circle" width="40" height="40" style="object-fit:cover;">
              <div>
                <div class="fw-bold" style="font-size:.9rem;color:var(--text-primary,var(--text))"><%= user.Name %></div>
                <div id="modalDestination" style="font-size:.75rem;color:var(--muted)"></div>
              </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>

          <div id="modalRoteiroBox" style="display:none;background:var(--surface2,var(--surface));padding:10px 16px;flex-shrink:0;border-bottom:1px solid var(--border);">
            <div style="color:var(--accent);font-size:.8rem;font-weight:700;">
              <i class="fa-solid fa-route me-1"></i><span id="modalRoteiroName"></span>
            </div>
            <div id="modalRoteiroDestination" style="color:var(--muted);font-size:.75rem;margin-top:2px;"></div>
          </div>

          <div class="p-3" style="border-bottom:1px solid var(--border);flex-shrink:0;">
            <p id="modalDesc" class="mb-1" style="color:var(--text-primary,var(--text));line-height:1.7;font-size:.88rem;"></p>
            <div id="modalDate" style="color:var(--muted);margin-top:4px;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em;"></div>
          </div>

          <div id="modalComments" class="p-3 overflow-auto flex-grow-1" style="min-height:0;"></div>

          <div class="p-3" style="border-top:1px solid var(--border);flex-shrink:0;">
            <div class="d-flex align-items-center gap-3 mb-2">
              <button id="modalLikeBtn" onclick="toggleLike()" style="background:none;border:none;padding:0;cursor:pointer;font-size:1.4rem;line-height:1;">
                <i class="fa-regular fa-heart text-secondary"></i>
              </button>
              <i class="fa-regular fa-comment text-secondary" style="font-size:1.3rem;cursor:pointer;" onclick="document.getElementById('modalCommentInput').focus()"></i>
              <i class="fa-regular fa-bookmark text-secondary ms-auto" style="font-size:1.3rem;cursor:pointer;"></i>
            </div>
            <div id="modalLikesCount" class="fw-bold mb-2" style="font-size:.85rem;color:var(--text-primary,var(--text))"></div>
            <div class="d-flex gap-2 align-items-center" style="border-top:1px solid var(--border);padding-top:10px;">
              <input id="modalCommentInput" type="text" placeholder="Add a comment..."
                style="flex:1;background:transparent;border:none;outline:none;color:var(--text-primary,var(--text));font-size:.85rem;"
                onkeydown="if(event.key==='Enter') submitComment()">
              <button onclick="submitComment()" style="background:none;border:none;color:#f59e0b;font-weight:600;font-size:.85rem;cursor:pointer;">Post</button>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
let currentPostId = null, currentPhotos = [], currentPhotoIdx = 0;

function imgFallback(el) { el.src = '/assets/images/default-avatar.jpg'; }

function openPostModal(card) {
    currentPostId   = card.dataset.postId;
    currentPhotos   = JSON.parse(card.dataset.photos || '[]');
    currentPhotoIdx = 0;
    updatePhoto();
    const hasMult = currentPhotos.length > 1;
    document.getElementById('btnPrev').style.display      = hasMult ? 'flex' : 'none';
    document.getElementById('btnNext').style.display      = hasMult ? 'flex' : 'none';
    document.getElementById('photoCounter').style.display = hasMult ? 'block' : 'none';
    document.getElementById('modalDestination').textContent = card.dataset.destination || '';
    const rBox = document.getElementById('modalRoteiroBox');
    if (card.dataset.roteiro) {
        rBox.style.display = 'block';
        document.getElementById('modalRoteiroName').textContent        = card.dataset.roteiro;
        document.getElementById('modalRoteiroDestination').textContent = card.dataset.destination || '';
    } else { rBox.style.display = 'none'; }
    document.getElementById('modalDesc').textContent       = card.dataset.desc || '';
    document.getElementById('modalDate').textContent       = card.dataset.date || '';
    document.getElementById('modalLikesCount').textContent = card.dataset.likes + ' likes';
    document.getElementById('modalLikeBtn').querySelector('i').className =
        card.dataset.liked === '1' ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart text-secondary';
    loadComments(currentPostId);
    new bootstrap.Modal(document.getElementById('postDetailModal')).show();
}
function updatePhoto() {
    const img = document.getElementById('modalPhoto');
    if (!currentPhotos.length) { img.src = ''; img.style.display = 'none'; return; }
    img.style.display = 'block';
    img.src = currentPhotos[currentPhotoIdx];
    document.getElementById('photoCounter').textContent = (currentPhotoIdx+1) + ' / ' + currentPhotos.length;
}
function prevPhoto() { currentPhotoIdx = (currentPhotoIdx-1+currentPhotos.length)%currentPhotos.length; updatePhoto(); }
function nextPhoto() { currentPhotoIdx = (currentPhotoIdx+1)%currentPhotos.length; updatePhoto(); }

async function loadComments(postId) {
    const c = document.getElementById('modalComments');
    c.innerHTML = '<p class="text-secondary small text-center pt-4">Loading...</p>';
    try {
        const res  = await fetch('/dashboard/' + postId + '/comments');
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (!data.length) {
            c.innerHTML = '<div class="text-center pt-5"><i class="fa-regular fa-comment fa-2x text-secondary mb-2 d-block"></i><p class="text-secondary small">No comments yet.</p></div>';
            return;
        }
        c.innerHTML = data.map(function(x) {
            return '<div class="d-flex gap-2 mb-3 align-items-start">' +
                '<img src="' + (x.Avatar_Url || '/assets/images/default-avatar.jpg') + '" class="rounded-circle flex-shrink-0" width="30" height="30" style="object-fit:cover;margin-top:2px;" onerror="imgFallback(this)">' +
                '<div style="background:var(--surface2,var(--surface));border-radius:10px;padding:8px 12px;flex:1;">' +
                '<span style="font-size:.82rem;color:var(--accent);font-weight:700;">' + x.First_Name + '</span>' +
                '<p class="mb-0 mt-1" style="font-size:.83rem;color:var(--text-primary,var(--text));line-height:1.5;">' + x.S_COMMENT + '</p>' +
                '</div></div>';
        }).join('');
        c.scrollTop = c.scrollHeight;
    } catch(e) { c.innerHTML = '<p class="text-danger small text-center pt-3">Error loading comments.</p>'; }
}

async function toggleLike() {
    if (!currentPostId) return;
    const icon = document.getElementById('modalLikeBtn').querySelector('i');
    const res  = await fetch('/dashboard/' + currentPostId + '/like', { method: 'POST' });
    const data = await res.json();
    icon.className = data.liked ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart text-secondary';
    const el = document.getElementById('modalLikesCount');
    const n  = parseInt(el.textContent) || 0;
    el.textContent = (data.liked ? n+1 : Math.max(0,n-1)) + ' likes';
}

async function submitComment() {
    const input = document.getElementById('modalCommentInput');
    const text  = input.value.trim();
    if (!text || !currentPostId) return;
    await fetch('/dashboard/' + currentPostId + '/comment', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ commentText: text })
    });
    input.value = '';
    loadComments(currentPostId);
}

document.addEventListener('keydown', function(e) {
    if (!document.getElementById('postDetailModal').classList.contains('show')) return;
    if (e.key === 'ArrowLeft')  prevPhoto();
    if (e.key === 'ArrowRight') nextPhoto();
});

(function() {
    const input    = document.getElementById('searchInput');
    const dropdown = document.getElementById('searchDropdown');
    let debounce;

    input.addEventListener('input', function() {
        clearTimeout(debounce);
        const q = input.value.trim();
        if (q.length < 2) { closeDropdown(); return; }
        debounce = setTimeout(function() { fetchUsers(q); }, 250);
    });

    input.addEventListener('focus', function() {
        if (input.value.trim().length >= 2) dropdown.classList.add('open');
    });

    document.addEventListener('click', function(e) {
        if (!document.getElementById('userSearch').contains(e.target)) closeDropdown();
    });

    async function fetchUsers(q) {
        try {
            const res  = await fetch('/users/search?q=' + encodeURIComponent(q));
            const data = await res.json();
            renderDropdown(data);
        } catch(e) { console.error(e); }
    }

    function renderDropdown(users) {
        if (!users.length) {
            dropdown.innerHTML = '<div class="pf-search__empty">No users found</div>';
        } else {
            dropdown.innerHTML = users.map(function(u) {
                return '<a href="/u/' + u.Guid + '" class="pf-search__item" onclick="closeSearch()">' +
                    '<img src="' + (u.Avatar_Url || '/assets/images/default-avatar.jpg') + '" onerror="imgFallback(this)">' +
                    '<div class="pf-search__item__info">' +
                    '<div class="pf-search__item__name">' + u.Name + '</div>' +
                    '<div class="pf-search__item__username">@' + u.Username + (u.Location ? ' · ' + u.Location : '') + '</div>' +
                    '</div></a>';
            }).join('');
        }
        dropdown.classList.add('open');
    }

    function closeDropdown() { dropdown.classList.remove('open'); }
    window.closeSearch = function() { input.value = ''; closeDropdown(); };
})();
</script>
<script src="/js/theme.js"></script>
<script>
// ── FAVORITES DATA (carregado em background no load) ──
let favData = null;

async function fetchFavorites() {
    try {
        const res = await fetch('/api/favorites');
        favData   = await res.json();
        document.getElementById('favCount').textContent = favData.length;
    } catch(e) { favData = []; }
}

function renderFavoritesPanel() {
    const container = document.getElementById('favoritesContent');
    if (!favData.length) {
        container.innerHTML = `
            <div class="pf-empty">
                <i class="fa-regular fa-heart"></i>
                <p>No favorites yet.<br>Like posts to see them here!</p>
            </div>`;
        return;
    }
    const grid = favData.map(function(post) {
        const photos = Array.isArray(post.PHOTOS_URLS)
            ? post.PHOTOS_URLS
            : (post.PHOTOS_URLS ? [post.PHOTOS_URLS] : []);
        const cover = photos[0] || null;
        const desc  = (post.T_DESC || '').replace(/"/g, '&quot;');
        const date  = post.D_CREATE_DATE
            ? new Date(post.D_CREATE_DATE).toLocaleDateString('pt-PT') : '';

        return `<div class="pf-post"
            data-post-id="${post.G_POST_ID}"
            data-photos='${JSON.stringify(photos)}'
            data-desc="${desc}"
            data-likes="${post.N_LIKES || 0}"
            data-comments="${post.N_COMMENTS || 0}"
            data-roteiro="${post.roteiro_title || ''}"
            data-destination="${post.roteiro_destination || ''}"
            data-date="${date}"
            data-liked="1"
            onclick="openPostModal(this)">
            <div class="pf-post__img-wrap">
                ${cover
                    ? `<img src="${cover}" alt="post" onerror="this.parentNode.innerHTML='<div class=pf-post__img-placeholder><i class=fa-solid fa-image></i></div>'">`
                    : '<div class="pf-post__img-placeholder"><i class="fa-solid fa-image"></i></div>'}
                ${photos.length > 1 ? `<span class="pf-post__count"><i class="fa-solid fa-images"></i> ${photos.length}</span>` : ''}
            </div>
            <div class="pf-post__body">
                ${post.poster_name ? `<div class="pf-post__route"><i class="fa-solid fa-user"></i> ${post.poster_name}</div>` : ''}
                <div class="pf-post__title">${post.T_DESC ? post.T_DESC.substring(0,65) + (post.T_DESC.length > 65 ? '…' : '') : 'No description'}</div>
                ${post.roteiro_destination ? `<div class="pf-post__location"><i class="fa-solid fa-location-dot"></i> ${post.roteiro_destination}</div>` : ''}
                <div class="pf-post__footer">
                    <div class="pf-post__stats">
                        <span><i class="fa-solid fa-heart text-danger"></i> ${post.N_LIKES || 0}</span>
                        <span><i class="fa-regular fa-comment"></i> ${post.N_COMMENTS || 0}</span>
                    </div>
                </div>
            </div>
        </div>`;
    }).join('');
    container.innerHTML = `<div class="pf-grid">${grid}</div>`;
}

// ── TAB SWITCHING ──
document.querySelectorAll('.pf-tab[data-tab]').forEach(function(tab) {
    tab.addEventListener('click', function(e) {
        e.preventDefault();
        const target = this.dataset.tab;

        document.querySelectorAll('.pf-tab').forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');

        document.querySelectorAll('[id^="tab-"]').forEach(function(el) { el.style.display = 'none'; });
        const panel = document.getElementById('tab-' + target);
        if (panel) panel.style.display = '';

        if (target === 'favorites') {
            if (favData !== null) {
                renderFavoritesPanel();
            } else {
                fetchFavorites().then(renderFavoritesPanel);
            }
        }
    });
});

// Carrega o count em background ao abrir a página
fetchFavorites();
</script>
</body>
</html>
