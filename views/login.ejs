<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Insight - Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>

    <div class="container">
        
        <div class="brand-header">
            <div class="logo-circle">
                <i class="fas fa-leaf"></i>
            </div>
            <h1 class="brand-name">INSIGHT</h1>
            <p class="brand-slogan">A tua rede social de viagens</p>
        </div>

        <div class="card">
            
            <% if (typeof errors !='undefined' ) { %>
                <div class="msg-container error">
                    <% errors.forEach(error=> { %>
                        <div><%= error.message %></div>
                    <% }) %>
                </div>
            <% } %>

            <% if(messages.success_msg) { %>
                <div class="msg-container success">
                    <%= messages.success_msg %>
                </div>
            <% } %>

            <% if (messages.error) { %>
                <div class="msg-container error">
                    <%= messages.error %>
                </div>
            <% } %>
            <div class="card-header">
                <h2>Iniciar sessão</h2>
                <p>Bem-vindo de volta! Introduz os teus dados.</p>
            </div>

            <form action="/users/login" method="POST" class="form-register">
                
                <div class="input-group">
                    <label for="email">Email</label>
                    <div class="input-wrapper">
                        <i class="fas fa-envelope input-icon"></i>
                        <input type="email" id="email" name="email" placeholder="o.teu@email.com" required />
                    </div>
                </div>

                <div class="input-group">
                    <label for="password">Password</label>
                    <div class="input-wrapper">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" id="password" name="password" placeholder="........" required />
                        <i class="fas fa-eye show-pass"></i>
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    Entrar <i class="fas fa-arrow-right"></i>
                </button>
            </form>

            <div class="card-footer">
                <p>Ainda não tens conta? <a href="/users/register">Criar conta</a></p>
            </div>
        </div>
    </div>

</body>
</html>