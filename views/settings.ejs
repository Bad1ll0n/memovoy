<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <script>(function(){var t=localStorage.getItem('insight-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configurações | Insight</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="/css/theme.css">
    <style>
        .settings-wrapper {
            max-width: 680px;
            margin: 90px auto 60px;
            padding: 0 20px;
        }
        .settings-title-row {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 32px;
        }
        .settings-back {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: var(--surface);
            border: 1px solid var(--border);
            display: flex; align-items: center; justify-content: center;
            color: var(--muted);
            text-decoration: none;
            transition: .2s;
        }
        .settings-back:hover { color: var(--text); background: var(--bg-hover, var(--surface2)); }
        .settings-title { font-size: 1.4rem; font-weight: 700; color: var(--text); margin: 0; }

        /* Secção */
        .settings-section { margin-bottom: 28px; }
        .settings-section-label {
            font-size: .7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--muted);
            margin-bottom: 10px;
            padding-left: 4px;
        }
        .settings-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
        }
        .settings-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            gap: 16px;
        }
        .settings-row:last-child { border-bottom: none; }
        .settings-row__left {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .settings-row__icon {
            width: 38px; height: 38px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
            flex-shrink: 0;
        }
        .settings-row__icon--theme { background: rgba(3,105,161,.12); color: #0369A1; }
        .settings-row__icon--lang  { background: rgba(252,163,17,.12); color: #fca311; }
        .settings-row__icon--notif { background: rgba(52,211,153,.12); color: #34D399; }
        .settings-row__icon--priv  { background: rgba(248,113,113,.12); color: #F87171; }
        [data-theme="dark"] .settings-row__icon--theme { background: rgba(56,189,248,.12); color: #38BDF8; }
        .settings-row__title { font-size: .9rem; font-weight: 600; color: var(--text); margin: 0; }
        .settings-row__sub   { font-size: .77rem; color: var(--muted); margin: 0; }
        .settings-row__right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

        /* Toggle switch */
        .theme-pill-toggle {
            display: flex;
            align-items: center;
            background: var(--bg, var(--bg-body));
            border: 1px solid var(--border);
            border-radius: 99px;
            padding: 4px;
            gap: 2px;
        }
        .theme-pill-btn {
            display: flex; align-items: center; gap: 6px;
            padding: 7px 16px;
            border-radius: 99px;
            border: none;
            background: transparent;
            color: var(--muted);
            font-size: .8rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s;
            font-family: 'Inter', sans-serif;
        }
        .theme-pill-btn.active {
            background: var(--surface2, var(--card));
            color: var(--text);
            box-shadow: 0 1px 4px rgba(0,0,0,.12);
        }
        .theme-pill-btn i { font-size: .85rem; }
    </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="pf-nav">
    <a class="pf-nav__brand" href="/dashboard">
        <i class="fa-solid fa-compass"></i> INSIGHT
    </a>
    <div class="pf-nav__links">
        <a href="/dashboard"><i class="fa-solid fa-house-chimney"></i> <%- t('nav.home') %></a>
        <a href="/profile_trips"><i class="fa-solid fa-heart"></i> <%- t('nav.myTrips') %></a>
    </div>
    <div class="pf-nav__right">
        <i class="fa-regular fa-bell pf-nav__bell"></i>
        <div class="dropdown">
            <img src="<%= user.Avatar_Url || '/assets/images/default-avatar.jpg' %>"
                class="pf-nav__avatar" role="button" data-bs-toggle="dropdown">
            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                <li><a class="dropdown-item" href="/profile"><%- t('nav.profile') %></a></li>
                <li><a class="dropdown-item" href="/profile/edit"><%- t('nav.editProfile') %></a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item active" href="/settings"><i class="fa-solid fa-gear me-2"></i><%- t('nav.settings') %></a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item text-danger" href="/logout"><%- t('nav.logout') %></a></li>
            </ul>
        </div>
    </div>
</nav>

<div class="settings-wrapper">

    <div class="settings-title-row">
        <a href="/dashboard" class="settings-back"><i class="fa-solid fa-arrow-left fa-sm"></i></a>
        <h1 class="settings-title"><%- t('settings.title') %></h1>
    </div>

    <!-- APARÊNCIA -->
    <div class="settings-section">
        <div class="settings-section-label"><%- t('settings.appearance') %></div>
        <div class="settings-card">
            <div class="settings-row">
                <div class="settings-row__left">
                    <div class="settings-row__icon settings-row__icon--theme">
                        <i class="fa-solid fa-circle-half-stroke"></i>
                    </div>
                    <div>
                        <p class="settings-row__title"><%- t('settings.theme') %></p>
                        <p class="settings-row__sub"><%- t('settings.themeDesc') %></p>
                    </div>
                </div>
                <div class="settings-row__right">
                    <div class="theme-pill-toggle">
                        <button class="theme-pill-btn" id="btnLight" onclick="setTheme('light')">
                            <i class="fa-solid fa-sun"></i> <%- t('settings.light') %>
                        </button>
                        <button class="theme-pill-btn" id="btnDark" onclick="setTheme('dark')">
                            <i class="fa-solid fa-moon"></i> <%- t('settings.dark') %>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- IDIOMA -->
    <div class="settings-section">
        <div class="settings-section-label"><%- t('settings.languageSection') %></div>
        <div class="settings-card">
            <div class="settings-row">
                <div class="settings-row__left">
                    <div class="settings-row__icon" style="background:rgba(96,165,250,.12);color:#60a5fa;">
                        <i class="fa-solid fa-globe"></i>
                    </div>
                    <div>
                        <p class="settings-row__title"><%- t('settings.language') %></p>
                        <p class="settings-row__sub"><%- t('settings.languageDesc') %></p>
                    </div>
                </div>
                <div class="settings-row__right">
                    <div class="theme-pill-toggle">
                        <a href="/settings/language/pt"
                           class="theme-pill-btn <%= i18n.language === 'pt' ? 'active' : '' %>"
                           style="text-decoration:none;">
                            🇵🇹 PT
                        </a>
                        <a href="/settings/language/en"
                           class="theme-pill-btn <%= i18n.language === 'en' ? 'active' : '' %>"
                           style="text-decoration:none;">
                            🇬🇧 EN
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- NOTIFICAÇÕES (placeholder) -->
    <div class="settings-section">
        <div class="settings-section-label"><%- t('settings.notifications') %></div>
        <div class="settings-card">
            <div class="settings-row">
                <div class="settings-row__left">
                    <div class="settings-row__icon settings-row__icon--notif">
                        <i class="fa-regular fa-bell"></i>
                    </div>
                    <div>
                        <p class="settings-row__title"><%- t('settings.pushNotif') %></p>
                        <p class="settings-row__sub"><%- t('settings.pushNotifDesc') %></p>
                    </div>
                </div>
                <div class="settings-row__right" style="color:var(--muted);font-size:.8rem;">
                    <%- t('settings.comingSoon') %>
                </div>
            </div>
        </div>
    </div>

    <!-- PRIVACIDADE (placeholder) -->
    <div class="settings-section">
        <div class="settings-section-label"><%- t('settings.privacy') %></div>
        <div class="settings-card">
            <div class="settings-row">
                <div class="settings-row__left">
                    <div class="settings-row__icon settings-row__icon--priv">
                        <i class="fa-solid fa-lock"></i>
                    </div>
                    <div>
                        <p class="settings-row__title"><%- t('settings.privateProfile') %></p>
                        <p class="settings-row__sub"><%- t('settings.privateProfileDesc') %></p>
                    </div>
                </div>
                <div class="settings-row__right" style="color:var(--muted);font-size:.8rem;">
                    <%- t('settings.comingSoon') %>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTA -->
    <div class="settings-section">
        <div class="settings-section-label"><%- t('settings.account') %></div>
        <div class="settings-card">
            <div class="settings-row">
                <div class="settings-row__left">
                    <div class="settings-row__icon" style="background:rgba(148,163,184,.12);color:var(--muted);">
                        <i class="fa-regular fa-user"></i>
                    </div>
                    <div>
                        <p class="settings-row__title"><%- t('settings.editProfile') %></p>
                        <p class="settings-row__sub"><%- t('settings.editProfileDesc') %></p>
                    </div>
                </div>
                <a href="/profile/edit" style="color:var(--muted);font-size:.85rem;text-decoration:none;">
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            </div>
            <a href="/logout" class="settings-row" style="text-decoration:none;">
                <div class="settings-row__left">
                    <div class="settings-row__icon" style="background:rgba(248,113,113,.12);color:#F87171;">
                        <i class="fa-solid fa-right-from-bracket"></i>
                    </div>
                    <div>
                        <p class="settings-row__title" style="color:#F87171;"><%- t('settings.signOut') %></p>
                        <p class="settings-row__sub"><%- t('settings.signOutDesc') %></p>
                    </div>
                </div>
                <span style="color:#F87171;font-size:.85rem;">
                    <i class="fa-solid fa-chevron-right"></i>
                </span>
            </a>
        </div>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function setTheme(theme) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('insight-theme', theme);
    updatePillButtons(theme);
}

function updatePillButtons(theme) {
    var btnLight = document.getElementById('btnLight');
    var btnDark  = document.getElementById('btnDark');
    if (!btnLight || !btnDark) return;
    btnLight.classList.toggle('active', theme === 'light');
    btnDark.classList.toggle('active',  theme === 'dark');
}

// Inicializa o estado dos botões
var currentTheme = localStorage.getItem('insight-theme') || 'light';
updatePillButtons(currentTheme);
</script>
<script src="/js/theme.js"></script>
</body>
</html>
