<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <script>(function(){var t=localStorage.getItem('insight-theme')||'light';document.documentElement.setAttribute('data-theme',t);})();</script>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Criar Roteiro — <%= destination %></title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/manualRoteiro.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>

<div class="hero">
  <div class="hero-badge"><i class="fa-solid fa-pencil"></i> <%- t('manualRoteiro.badge') %></div>
  <h1><%- t('manualRoteiro.titlePrefix') %> <%= destination %></h1>
  <div class="hero-meta">
    <span><i class="fa-solid fa-location-dot"></i> <%= destination %></span>
    <span><i class="fa-regular fa-calendar"></i> <%= departureDate %> → <%= returnDate %></span>
  </div>
</div>

<div class="builder-wrap">

  <!-- ── COLUNA ESQUERDA: Timeline ── -->
  <div>
    <div class="action-bar">
      <a href="/dashboard" class="btn-back-page"><i class="fa-solid fa-arrow-left"></i> <%- t('manualRoteiro.back') %></a>
      <button class="btn-save-itinerary" id="saveItineraryBtn">
        <i class="fa-solid fa-floppy-disk"></i> <%- t('manualRoteiro.save') %>
      </button>
    </div>

    <!-- Day tabs -->
    <div class="day-tabs" id="dayTabs"></div>

    <!-- Day panels (gerados pelo JS) -->
    <div id="dayPanelsWrap"></div>
  </div>

  <!-- ── COLUNA DIREITA: Adicionar atividades ── -->
  <div class="add-panel">
    <h6><i class="fa-solid fa-plus" style="color:var(--accent);margin-right:6px"></i><%- t('manualRoteiro.addActivity') %></h6>

    <!-- Pesquisa livre -->
    <label class="form-label-sm"><%- t('manualRoteiro.freeSearch') %></label>
    <div class="search-row">
      <input type="text" class="search-input-manual" id="searchActivityInput" placeholder="<%- t('manualRoteiro.freeSearchPlaceholder') %>">
      <button class="btn-search-manual" id="searchActivityBtn">
        <i class="fa-solid fa-magnifying-glass"></i>
      </button>
    </div>

    <div class="or-divider"><%- t('manualRoteiro.or') %></div>

    <!-- Sugestões IA -->
    <button class="btn-suggest-ia" id="suggestIaBtn">
      <i class="fa-solid fa-wand-magic-sparkles"></i> <%- t('manualRoteiro.aiSuggestions') %>
    </button>

    <!-- Lista de sugestões -->
    <div class="suggestions-section" id="suggestionsSection" style="display:none"></div>

    <div class="or-divider" id="formDivider" style="margin-top:16px"><%- t('manualRoteiro.add') %></div>

    <!-- Formulário de adição -->
    <div id="activityForm">
      <div class="form-group-sm">
        <label class="form-label-sm"><%- t('manualRoteiro.activityName') %></label>
        <input type="text" class="form-control-dark" id="actName" placeholder="<%- t('manualRoteiro.activityNamePlaceholder') %>">
      </div>

      <div class="form-group-sm">
        <label class="form-label-sm"><%- t('manualRoteiro.type') %></label>
        <select class="form-control-dark" id="actType">
          <option value="visita">🏛 <%- t('manualRoteiro.typeVisit') %></option>
          <option value="refeicao">🍽 <%- t('manualRoteiro.typeMeal') %></option>
          <option value="lazer">🎉 <%- t('manualRoteiro.typeLeisure') %></option>
          <option value="transporte">🚌 <%- t('manualRoteiro.typeTransport') %></option>
          <option value="alojamento">🏨 <%- t('manualRoteiro.typeAccommodation') %></option>
        </select>
      </div>

      <div class="time-row">
        <div>
          <label class="form-label-sm"><%- t('manualRoteiro.start') %></label>
          <input type="time" class="form-control-dark" id="actTimeStart" value="09:00">
        </div>
        <div>
          <label class="form-label-sm"><%- t('manualRoteiro.end') %></label>
          <input type="time" class="form-control-dark" id="actTimeEnd" value="11:00">
        </div>
      </div>

      <div class="form-group-sm">
        <label class="form-label-sm"><%- t('manualRoteiro.estimatedCost') %></label>
        <input type="text" class="form-control-dark" id="actCost" placeholder="<%- t('manualRoteiro.estimatedCostPlaceholder') %>">
      </div>

      <div class="form-group-sm">
        <label class="form-label-sm"><%- t('manualRoteiro.descOptional') %></label>
        <textarea class="form-control-dark" id="actDesc" rows="2" placeholder="<%- t('manualRoteiro.descPlaceholder') %>"></textarea>
      </div>

      <div class="form-group-sm">
        <label class="form-label-sm"><%- t('manualRoteiro.tipOptional') %></label>
        <input type="text" class="form-control-dark" id="actTip" placeholder="<%- t('manualRoteiro.tipPlaceholder') %>">
      </div>

      <button class="btn-add-activity" id="addActivityBtn">
        <i class="fa-solid fa-plus"></i> <%- t('manualRoteiro.addToDay') %>
      </button>
    </div>
  </div>

</div>

<!-- Toast container -->
<div class="toast-wrap" id="toastWrap"></div>

<!-- Modal Mapa -->
<div class="map-modal-overlay" id="mapModalOverlay">
  <div class="map-modal">
    <div class="map-modal-header">
      <span id="mapModalTitle"><%- t('manualRoteiro.dayRoute') %></span>
      <button class="map-modal-close" onclick="closeMapModal()"><i class="fa-solid fa-xmark"></i></button>
    </div>
    <div id="mapLoading" style="display:flex;align-items:center;justify-content:center;height:400px;color:#7d8fa9;font-size:.85rem;gap:10px;">
      <i class="fa-solid fa-spinner fa-spin"></i> <%- t('manualRoteiro.loadingMap') %>
    </div>
    <div id="dayMapContainer" style="height:500px;display:none;border-radius:0 0 12px 12px;"></div>
  </div>
</div>

<!-- Dados para o JS -->
<script type="application/json" id="builder-data">
{
  "destination": "<%= destination %>",
  "departureDate": "<%= departureDate %>",
  "returnDate": "<%= returnDate %>",
  "days": <%- days %>
}
</script>

<script>
window._mr = {
    noActivities: '<%- t("manualRoteiro.addActivity") %>',
    noActivitiesHint: '<%- t("manualRoteiro.freeSearch") %>',
    indicateName: '<%- t("manualRoteiro.activityName") %>',
    indicateStart: '<%- t("manualRoteiro.start") %>',
    activityAdded: '<%- t("manualRoteiro.addToDay") %>',
    saveFirst: '<%- t("manualRoteiro.save") %>',
    save: '<%- t("manualRoteiro.save") %>',
    day: '<%- t("itinerary.day") %>',
    dayRoute: '<%- t("manualRoteiro.dayRoute") %>',
    errorMap: '<%- t("common.error") %>',
    errorSuggest: '<%- t("common.error") %>',
    titlePlaceholder: '<%- t("myTrips.title") %>'
};
</script>
<script src="/vendor/bootstrap/js/bootstrap.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/manualRoteiro.js"></script>
<script src="/js/theme.js"></script>
</body>
</html>
