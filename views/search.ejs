<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pesquisar Viajantes | Insight</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/search_page.css">
</head>
<body>

<div class="container-fluid px-4">
    <div class="row">

        <!-- SIDEBAR -->
        <div class="col-lg-2 d-none d-lg-block">
            <a href="#"><img src="/assets/images/Insight_Logo.png" class="sidebar-logo" alt="INSIGHT"></a>

            <div class="sidebar-title">Descobrir</div>
            <a href="/dashboard" class="menu-item"><i class="fa-regular fa-compass"></i> Feed</a>
            <a class="menu-item active" href="/users"><i class="fa-solid fa-magnifying-glass"></i> Pesquisar</a>
            <a class="menu-item" href="#"><i class="fa-solid fa-plus me-1"></i> New Trip</a>
            <a href="#" class="menu-item"><i class="fa-solid fa-arrow-trend-up"></i> Trending</a>
            <a href="#" class="menu-item"><i class="fa-regular fa-map"></i> Mapa</a>

            <div class="sidebar-title">Pessoal</div>
            <a href="/favorites" class="menu-item"><i class="fa-regular fa-heart"></i> Favoritos</a>
            <a href="#" class="menu-item"><i class="fa-regular fa-bookmark"></i> Guardados</a>
            <a href="#" class="menu-item"><i class="fa-regular fa-calendar"></i> Planeados</a>
            <a href="/notifications" class="menu-item">
                <i class="fa-regular fa-bell"></i> Notificações
                <% if (locals.unreadNotifications && unreadNotifications > 0) { %>
                    <span class="badge-custom"><%= unreadNotifications %></span>
                <% } %>
            </a>
            <a href="/messages" class="menu-item">
                <i class="fa-regular fa-envelope"></i> Mensagens
                <% if (locals.unreadMessages && unreadMessages > 0) { %>
                    <span class="badge-custom"><%= unreadMessages %></span>
                <% } %>
            </a>

            <div class="sidebar-title">Outros</div>
            <a href="#" class="menu-item"><i class="fa-solid fa-users"></i> Comunidade</a>
            <a href="/settings" class="menu-item"><i class="fa-solid fa-gear"></i> Definições</a>

            <div class="menu-item">
                <a href="/profile" class="menu-item-username d-flex align-items-center text-decoration-none" style="gap:12px;">
                    <img src="<%= user.Avatar_Url || '/assets/images/default-avatar.jpg' %>"
                        class="rounded-circle border border-secondary" width="38" height="38"
                        style="object-fit:cover;" alt="<%= user.Name %>">
                    <span style="color:inherit;font-size:inherit;"><%= user.Name %></span>
                </a>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="col-lg-6 col-md-10 mx-auto mt-4">

            <div class="sp-page-header">
                <h2 class="sp-title">Pesquisar Viajantes</h2>
                <p class="sp-subtitle">Encontra outros exploradores e inspira-te.</p>
            </div>

            <!-- SEARCH BAR -->
            <div class="sp-search-row">
                <div class="sp-search-input-wrap">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="searchInput"
                        placeholder="Pesquisar por nome, username ou bio..."
                        autocomplete="off">
                </div>
            </div>

            <!-- RESULTS COUNT -->
            <div id="resultsCount" class="sp-results-count"></div>

            <!-- USER LIST -->
            <div id="userList" class="sp-user-list">
                <div class="sp-loading"><i class="fa-solid fa-circle-notch fa-spin"></i></div>
            </div>

        </div>

        <!-- RIGHT SIDEBAR -->
        <div class="col-lg-3 d-none d-lg-block mt-4">
            <div class="summary-card text-center">
                <h6 class="text-white mb-3 text-start">Resumo Rápido</h6>
                <div class="row">
                    <div class="col-6 mb-3">
                        <div class="stat-number">—</div>
                        <div class="stat-label">Países</div>
                    </div>
                    <div class="col-6 mb-3">
                        <div class="stat-number">—</div>
                        <div class="stat-label">Posts</div>
                    </div>
                    <div class="col-6">
                        <div class="stat-number" id="myFollowers">—</div>
                        <div class="stat-label">Seguidores</div>
                    </div>
                    <div class="col-6">
                        <div class="stat-number">—</div>
                        <div class="stat-label">Likes</div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="/vendor/jquery/jquery.min.js"></script>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
<script>
const searchInput  = document.getElementById('searchInput');
const userList     = document.getElementById('userList');
const resultsCount = document.getElementById('resultsCount');
let debounce;

function formatNum(n) {
    n = parseInt(n) || 0;
    if (n >= 1000) return (n/1000).toFixed(1).replace('.0','') + 'k';
    return n;
}

async function fetchUsers(q) {
    try {
        const url = '/users/search' + (q ? '?q=' + encodeURIComponent(q) : '?q=');
        const res  = await fetch(url);
        const data = await res.json();
        renderUsers(data);
    } catch(e) { console.error(e); }
}

function renderUsers(users) {
    resultsCount.textContent = users.length + ' resultado' + (users.length !== 1 ? 's' : '');

    if (!users.length) {
        userList.innerHTML = '<div class="sp-empty"><i class="fa-solid fa-user-slash"></i><p>Nenhum utilizador encontrado.</p></div>';
        return;
    }

    userList.innerHTML = users.map(function(u) {
        var followers = formatNum(u.followers);
        return '<a href="/u/' + u.Guid + '" class="sp-user-card">' +
            '<img src="' + (u.Avatar_Url || '/assets/images/default-avatar.jpg') + '" class="sp-user-avatar" onerror="this.src=\'/assets/images/default-avatar.jpg\'">' +
            '<div class="sp-user-info">' +
                '<div class="sp-user-name">' + u.Name + '</div>' +
                '<div class="sp-user-username">@' + u.Username + '</div>' +
                (u.Bio ? '<div class="sp-user-bio">' + u.Bio.substring(0,80) + (u.Bio.length > 80 ? '…' : '') + '</div>' : '') +
            '</div>' +
            '<div class="sp-user-stats">' +
                (u.Location ? '<span class="sp-stat-item"><i class="fa-solid fa-globe"></i><div class="sp-stat-val">—</div><div class="sp-stat-lbl">países</div></span>' : '') +
                '<span class="sp-stat-item"><i class="fa-solid fa-users"></i><div class="sp-stat-val">' + followers + '</div><div class="sp-stat-lbl">seguidores</div></span>' +
            '</div>' +
        '</a>';
    }).join('');
}

searchInput.addEventListener('input', function() {
    clearTimeout(debounce);
    const q = this.value.trim();
    debounce = setTimeout(function() { fetchUsers(q); }, 250);
});

document.addEventListener('DOMContentLoaded', function() { fetchUsers(''); });
</script>
</body>
</html>
